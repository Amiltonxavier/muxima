{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs"
	},
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"@muxima/api": "workspace:*",
		"@muxima/auth": "workspace:*",
		"@muxima/db": "workspace:*",
		"@muxima/env": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"fastify": "^5.10.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@muxima/config": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	}
}
