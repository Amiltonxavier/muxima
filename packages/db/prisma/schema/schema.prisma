generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum EventType {
  ENGAGEMENT
  WEDDING
  BIRTHDAY
  CONFERENCE
  WORKSHOP
  GRADUATION
  DINNER
  CORPORATE
  BABY_SHOWER
  CEREMONY
  PARTY
}

enum EventStatus {
  DRAFT
  PLANNING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum MemberRole {
  OWNER
  PARTNER
  ADMIN
  EDITOR
  VIEWER
}

enum MemberStatus {
  PENDING
  ACTIVE
  DECLINED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ExpenseType {
  EXPENSE
  INCOME
}

enum ExpenseStatus {
  PLANNED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ATM
  CARD
  MOBILE_PAYMENT
  OTHER
}

enum VendorCategory {
  VENUE
  DECORATION
  MUSIC
  PHOTOGRAPHY
  VIDEO
  CATERING
  CAKE
  DRINKS
  TRANSPORT
  BEAUTY
  SECURITY
  ENTERTAINMENT
  OTHER
}

enum VendorStatus {
  PROSPECT
  CONTACTED
  NEGOTIATING
  CONTRACTED
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GuestType {
  FAMILY
  FRIEND
  COLLEAGUE
  VIP
  OTHER
}

enum GuestStatus {
  PENDING
  CONFIRMED
  DECLINED
  WAITING
  CANCELLED
  MAYBE
}

enum CompanionStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum GuestInvitationStatus {
  CREATED
  SENT
  OPENED
  RESPONDED
  EXPIRED
  CANCELLED
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  MAYBE
  DECLINED
}

enum TaskCategory {
  FINANCE
  VENUE
  GUESTS
  FOOD
  DRINKS
  DECORATION
  CEREMONY
  DOCUMENTS
  CLOTHING
  TRANSPORT
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ScheduleStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InventoryCategory {
  DRINK
  FOOD
  CAKE
  DECORATION
  OTHER
}

enum InventoryUnit {
  UNIT
  BOX
  CASE
  BOTTLE
  KG
  LITER
  PACKAGE
  OTHER
}

enum MovementType {
  PURCHASE
  ADD
  CONSUMPTION
  ADJUSTMENT
  LOSS
  RETURN
}

enum DocumentType {
  CONTRACT
  RECEIPT
  QUOTE
  OTHER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum NotificationType {
  FINANCE
  TASKS
  GUESTS
  INVENTORY
  EVENT
}

enum NotificationPriority {
  INFO
  WARNING
  IMPORTANT
  CRITICAL
}

// ============================================================
// Models
// ============================================================

model Event {
  id          String      @id @default(uuid())
  ownerId     String
  name        String
  type        EventType
  status      EventStatus @default(DRAFT)
  eventDate   DateTime?
  startTime   String?
  endTime     String?
  venueName   String?
  address     String?
  province    String?
  municipality String?
  neighborhood String?
  reference   String?
  latitude    Float?
  longitude   Float?
  capacity    Int?
  limitGuestCapacity Boolean @default(false)
  currency    String      @default("AOA")
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner           User              @relation(fields: [ownerId], references: [id])
  members         EventMember[]
  invitations     EventInvitation[]
  budget          Budget?
  budgetCategories BudgetCategory[]
  expenses        Expense[]
  vendors         Vendor[]
  vendorContracts VendorContract[]
  guests          Guest[]
  guestInvitations GuestInvitation[]
  tables          Table[]
  tasks           Task[]
  schedules       Schedule[]
  inventoryItems  InventoryItem[]
  documents       Document[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([ownerId])
  @@map("event")
}

model EventMember {
  id        String       @id @default(uuid())
  eventId   String
  userId    String
  role      MemberRole
  status    MemberStatus @default(PENDING)
  joinedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_member")
}

model EventInvitation {
  id         String             @id @default(uuid())
  eventId    String
  invitedBy  String
  email      String?
  phone      String?
  role       MemberRole
  token      String
  status     InvitationStatus   @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviter User  @relation(fields: [invitedBy], references: [id])

  @@index([eventId])
  @@index([invitedBy])
  @@index([token])
  @@map("event_invitation")
}

model Budget {
  id             String   @id @default(uuid())
  eventId        String   @unique
  plannedAmount  Decimal
  reserveAmount  Decimal? @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("budget")
}

model BudgetCategory {
  id             String   @id @default(uuid())
  eventId        String
  name           String
  description    String?
  plannedAmount  Decimal  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([eventId])
  @@map("budget_category")
}

model Expense {
  id               String        @id @default(uuid())
  eventId          String
  budgetCategoryId String?
  vendorId         String?
  description      String
  type             ExpenseType   @default(EXPENSE)
  totalAmount      Decimal
  dueDate          DateTime?
  status           ExpenseStatus @default(PLANNED)
  paidPercentage   Float         @default(0)
  notes            String?
  createdBy        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  budgetCategory BudgetCategory? @relation(fields: [budgetCategoryId], references: [id])
  vendor         Vendor?        @relation(fields: [vendorId], references: [id])
  payments       Payment[]
  documents      Document[]
  creator        User           @relation(fields: [createdBy], references: [id])

  @@index([eventId])
  @@index([budgetCategoryId])
  @@index([vendorId])
  @@index([createdBy])
  @@map("expense")
}

model Payment {
  id          String        @id @default(uuid())
  expenseId   String
  amount      Decimal
  paymentDate DateTime
  method      PaymentMethod
  reference   String?
  notes       String?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  expense  Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id])
  documents Document[]

  @@index([expenseId])
  @@index([createdBy])
  @@map("payment")
}

model Vendor {
  id          String         @id @default(uuid())
  eventId     String
  name        String
  category    VendorCategory
  phone       String?
  email       String?
  address     String?
  status      VendorStatus   @default(PROSPECT)
  description String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  contracts VendorContract[]
  inventoryItems InventoryItem[]
  documents Document[]

  @@index([eventId])
  @@map("vendor")
}

model VendorContract {
  id         String         @id @default(uuid())
  eventId    String
  vendorId   String
  number     String?
  startDate  DateTime?
  endDate    DateTime?
  amount     Decimal?
  status     ContractStatus @default(DRAFT)
  documentId String?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([vendorId])
  @@map("vendor_contract")
}

model Guest {
  id              String      @id @default(uuid())
  eventId         String
  name            String
  phone           String?
  email           String?
  group           String?
  type            GuestType
  status          GuestStatus @default(PENDING)
  companionsLimit Int         @default(0)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  companions  GuestCompanion[]
  tableGuests TableGuest[]
  invitationGuests InvitationGuest[]

  @@index([eventId])
  @@map("guest")
}

model GuestCompanion {
  id        String            @id @default(uuid())
  guestId   String
  name      String
  status    CompanionStatus   @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@map("guest_companion")
}

model GuestInvitation {
  id         String                  @id @default(uuid())
  eventId    String
  code       String
  url        String?
  status     GuestInvitationStatus   @default(CREATED)
  sentAt     DateTime?
  openedAt   DateTime?
  respondedAt DateTime?
  response   String?
  qrCode     String?
  rsvpStatus RsvpStatus             @default(PENDING)
  expiresAt  DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  event  Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests InvitationGuest[]

  @@unique([code])
  @@index([eventId])
  @@map("guest_invitation")
}

model InvitationGuest {
  id              String   @id @default(uuid())
  invitationId    String
  guestId         String
  createdAt       DateTime @default(now())

  invitation GuestInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([invitationId, guestId])
  @@index([invitationId])
  @@index([guestId])
  @@map("invitation_guest")
}

model Table {
  id        String    @id @default(uuid())
  eventId   String
  name      String
  number    Int?
  capacity  Int
  location  String?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableGuests TableGuest[]

  @@index([eventId])
  @@map("table")
}

model TableGuest {
  id         String   @id @default(uuid())
  tableId    String
  guestId    String
  assignedAt DateTime @default(now())

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([tableId, guestId])
  @@index([tableId])
  @@index([guestId])
  @@map("table_guest")
}

model Task {
  id          String       @id @default(uuid())
  eventId     String
  title       String
  description String?
  category    TaskCategory
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  assignedTo  String?
  dueDate     DateTime?
  completedAt DateTime?
  completedBy String?
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  event          Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee       User?  @relation("TaskAssignee", fields: [assignedTo], references: [id])
  completer      User?  @relation("TaskCompleter", fields: [completedBy], references: [id])
  creator        User   @relation("TaskCreator", fields: [createdBy], references: [id])

  @@index([eventId])
  @@index([assignedTo])
  @@index([createdBy])
  @@map("task")
}

model Schedule {
  id          String         @id @default(uuid())
  eventId     String
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  location    String?
  responsible String?
  status      ScheduleStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("schedule")
}

model InventoryItem {
  id               String            @id @default(uuid())
  eventId          String
  name             String
  category         InventoryCategory
  plannedQuantity  Decimal
  currentQuantity  Decimal           @default(0)
  unit             InventoryUnit
  unitPrice        Decimal?
  vendorId         String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor    Vendor?            @relation(fields: [vendorId], references: [id])
  movements InventoryMovement[]

  @@index([eventId])
  @@index([vendorId])
  @@map("inventory_item")
}

model InventoryMovement {
  id              String       @id @default(uuid())
  inventoryItemId String
  type            MovementType
  quantity        Decimal
  reason          String?
  createdBy       String
  createdAt       DateTime     @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  creator       User          @relation(fields: [createdBy], references: [id])

  @@index([inventoryItemId])
  @@index([createdBy])
  @@map("inventory_movement")
}

model Document {
  id         String         @id @default(uuid())
  eventId    String
  name       String
  type       DocumentType
  reference  String?
  vendorId   String?
  expenseId  String?
  paymentId  String?
  status     DocumentStatus @default(ACTIVE)
  createdBy  String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor  Vendor?  @relation(fields: [vendorId], references: [id])
  expense Expense? @relation(fields: [expenseId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
  creator User     @relation(fields: [createdBy], references: [id])

  @@index([eventId])
  @@index([vendorId])
  @@index([expenseId])
  @@index([paymentId])
  @@index([createdBy])
  @@map("document")
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  eventId   String?
  type      NotificationType
  title     String
  message   String
  priority  NotificationPriority @default(INFO)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@map("notification")
}

model AuditLog {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@map("audit_log")
}
