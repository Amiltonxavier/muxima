generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum EventType {
  ENGAGEMENT
  WEDDING
  BIRTHDAY
  CONFERENCE
  WORKSHOP
  GRADUATION
  DINNER
  CORPORATE
  BABY_SHOWER
  CEREMONY
  PARTY
}

enum EventStatus {
  DRAFT
  PLANNING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum MemberRole {
  OWNER
  PARTNER
  ADMIN
  EDITOR
  VIEWER
}

enum MemberStatus {
  PENDING
  ACTIVE
  DECLINED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ATM
  CARD
  MOBILE_PAYMENT
  MULTICAIXA_EXPRESS
  OTHER
}

enum SupplierCategory {
  VENUE
  CATERING
  CAKE
  SWEETS_AND_SAVOURIES
  DECORATION
  FLORIST
  PHOTOGRAPHER
  VIDEOGRAPHER
  DJ
  BAND
  MUSIC
  ENTERTAINMENT
  TRANSPORT
  BEAUTY
  BRIDE_ATTIRE
  GROOM_ATTIRE
  RINGS
  WEDDING_PLANNER
  OFFICIANT
  FAVOURS
  ACCOMMODATION
  SECURITY
  OTHER
}

enum SupplierStatus {
  PROSPECT
  CONTACTED
  NEGOTIATING
  CONFIRMED
  COMPLETED
  CANCELLED
}
/// Denormalised mirror of the amount computed by the backend resolver.
/// Never trusted on read: the API always recomputes from price +
/// installments + payments.
enum SupplierPaymentStatus {
  PENDING
  PAID
  INSTALLMENTS
  OVERDUE
  CANCELLED
}

enum SupplierPaymentModel {
  FULL
  INSTALLMENTS
  CUSTOM
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum FoodPlanCategory {
  STARTER
  MAIN_COURSE
  SIDE_DISH
  DESSERT
  FRUIT
  OTHER
}

enum FoodPlanUnit {
  UNIT
  PLATE
  BOWL
  PORTION
  GRAM
  KILOGRAM
  LITER
  GLASS
  BOTTLE
  PACKAGE
  OTHER
}

enum FoodPlanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ChecklistStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GuestType {
  FAMILY
  FRIEND
  COLLEAGUE
  VIP
  OTHER
}

enum GuestStatus {
  PENDING
  CONFIRMED
  DECLINED
  WAITING
  CANCELLED
  MAYBE
}

enum CompanionStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum GuestInvitationStatus {
  CREATED
  SENT
  OPENED
  RESPONDED
  EXPIRED
  CANCELLED
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  MAYBE
  DECLINED
}

enum TaskCategory {
  FINANCE
  VENUE
  GUESTS
  FOOD
  DRINKS
  DECORATION
  CEREMONY
  DOCUMENTS
  CLOTHING
  TRANSPORT
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ScheduleStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InventoryCategory {
  DRINK
  MATERIAL
  EQUIPMENT
  FURNITURE
  LINEN
  OTHER
}

enum InventoryUnit {
  UNIT
  BOX
  CASE
  BOTTLE
  KG
  LITER
  PACKAGE
  OTHER
}

enum MovementType {
  PURCHASE
  ADD
  CONSUMPTION
  ADJUSTMENT
  LOSS
  RETURN
}

enum InventoryStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  FINANCE
  TASKS
  GUESTS
  INVENTORY
  EVENT
}

enum NotificationPriority {
  INFO
  WARNING
  IMPORTANT
  CRITICAL
}

// Extensible list of personal message kinds. New kinds (BIRTHDAY_MESSAGE,
// ANNIVERSARY_MESSAGE, SPECIAL_MESSAGE, THANK_YOU, OTHER…) are added here
// only — no feature code branches on a specific member.
enum DedicationType {
  WEDDING_VOW
  ENGAGEMENT_VOW
  DEDICATION
}

// Writing phase of a dedication. Kept as an enum (never a boolean) so the
// owner can tell at a glance how far along the text is.
enum DedicationStatus {
  NOT_STARTED
  DRAFT
  IN_PROGRESS
  READY
}

// ============================================================
// Models
// ============================================================

model Event {
  id                 String      @id @default(uuid())
  ownerId            String
  name               String
  type               EventType
  status             EventStatus @default(DRAFT)
  eventDate          DateTime?
  startTime          String?
  endTime            String?
  venueName          String?
  address            String?
  province           String?
  municipality       String?
  neighborhood       String?
  reference          String?
  latitude           Float?
  longitude          Float?
  capacity           Int?
  limitGuestCapacity Boolean     @default(false)
  currency           String      @default("AOA")
  description        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  owner            User              @relation(fields: [ownerId], references: [id])
  members          EventMember[]
  invitations      EventInvitation[]
  budget           Budget?
  suppliers        Supplier[]
  foodPlans        FoodPlan[]
  foodPlanItems    FoodPlanItem[]
  checklistItems   ChecklistItem[]
  guests           Guest[]
  guestInvitations GuestInvitation[]
  tables           Table[]
  tasks            Task[]
  schedules        Schedule[]
  inventoryItems   InventoryItem[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  activityLogs     ActivityLog[]
  dedications      Dedication[]

  @@index([ownerId])
  @@map("event")
}

model EventMember {
  id        String       @id @default(uuid())
  eventId   String
  userId    String
  role      MemberRole
  status    MemberStatus @default(PENDING)
  joinedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id])
  dedicationViews DedicationViewer[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_member")
}

model EventInvitation {
  id         String           @id @default(uuid())
  eventId    String
  invitedBy  String
  email      String?
  phone      String?
  role       MemberRole
  token      String
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviter User  @relation(fields: [invitedBy], references: [id])

  @@index([eventId])
  @@index([invitedBy])
  @@index([token])
  @@map("event_invitation")
}

/// Planning target for the event. Every derived figure (totalBudget,
/// totalSpent, totalPaid, totalPending, totalOverdue, breakdown, analytics)
/// is computed by the API from Inventory + Suppliers; nothing is stored here.
model Budget {
  id            String   @id @default(uuid())
  eventId       String   @unique
  plannedAmount Decimal  @default(0)
  reserveAmount Decimal? @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("budget")
}

model Supplier {
  id             String                @id @default(uuid())
  eventId        String
  name           String
  category       SupplierCategory
  /// Agreed amount. Nullable so a supplier can exist before negotiation ends.
  price          Decimal?
  phone          String?
  email          String?
  address        String?
  /// Tax identification number (optional, validated by the API when set).
  nif            String?
  /// Bank details (optional).
  iban           String?
  /// Whether the supplier accepts MULTICAIXA Express (mobile payments).
  hasMcxExpress  Boolean               @default(false)
  /// Phone number associated with the supplier's MULTICAIXA Express.
  mcxPhone       String?
  status         SupplierStatus        @default(PROSPECT)
  paymentModel   SupplierPaymentModel  @default(FULL)
  paymentStatus  SupplierPaymentStatus @default(PENDING)
  /// Denormalised: sum of installment due dates before the nearest one.
  nextDueDate    DateTime?
  description    String?
  notes          String?
  /// Category-specific fields, validated per-category by the API.
  categoryFields Json?
  /// Free-form extra fields defined by the user.
  customFields   Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  event          Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments       SupplierPayment[]
  installments   SupplierInstallment[]
  foodPlans      FoodPlan[]
  checklistItems ChecklistItem[]

  @@index([eventId])
  @@index([eventId, status])
  @@index([eventId, category])
  @@map("supplier")
}

model SupplierPayment {
  id          String        @id @default(uuid())
  supplierId  String
  amount      Decimal
  paymentDate DateTime
  method      PaymentMethod
  reference   String?
  notes       String?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id])

  @@index([supplierId])
  @@index([createdBy])
  @@map("supplier_payment")
}

model SupplierInstallment {
  id         String            @id @default(uuid())
  supplierId String
  position   Int               @default(1)
  amount     Decimal
  dueDate    DateTime
  paidAt     DateTime?
  status     InstallmentStatus @default(PENDING)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, position])
  @@index([supplierId])
  @@map("supplier_installment")
}

/// One food plan per event. A single supplier may be attached to it, and
/// only one — the API rejects a second, different supplier.
model FoodPlan {
  id         String   @id @default(uuid())
  eventId    String   @unique
  supplierId String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    FoodPlanItem[]

  @@index([supplierId])
  @@map("food_plan")
}

/// No prices here by design: catering/sweets/cake money lives on Supplier.
model FoodPlanItem {
  id           String           @id @default(uuid())
  eventId      String
  foodPlanId   String
  name         String
  category     FoodPlanCategory
  quantity     Decimal          @default(1)
  unit         FoodPlanUnit     @default(PORTION)
  description  String?
  notes        String?
  status       FoodPlanStatus   @default(PENDING)
  customFields Json?
  position     Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  foodPlan FoodPlan @relation(fields: [foodPlanId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([foodPlanId])
  @@map("food_plan_item")
}

model ChecklistItem {
  id              String          @id @default(uuid())
  eventId         String
  title           String
  description     String?
  status          ChecklistStatus @default(PENDING)
  position        Int             @default(0)
  dueDate         DateTime?
  supplierId      String?
  inventoryItemId String?
  /// True when the status is maintained by the API from the linked
  /// supplier/inventory state rather than by a user action.
  autoManaged     Boolean         @default(false)
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([supplierId])
  @@index([inventoryItemId])
  @@map("checklist_item")
}

model Guest {
  id              String      @id @default(uuid())
  eventId         String
  name            String
  phone           String?
  email           String?
  group           String?
  type            GuestType
  status          GuestStatus @default(PENDING)
  companionsLimit Int         @default(0)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  companions       GuestCompanion[]
  tableGuests      TableGuest[]
  invitationGuests InvitationGuest[]

  @@index([eventId])
  @@map("guest")
}

model GuestCompanion {
  id        String          @id @default(uuid())
  guestId   String
  name      String
  status    CompanionStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@map("guest_companion")
}

model GuestInvitation {
  id          String                @id @default(uuid())
  eventId     String
  code        String
  url         String?
  status      GuestInvitationStatus @default(CREATED)
  sentAt      DateTime?
  openedAt    DateTime?
  respondedAt DateTime?
  publishedAt DateTime?
  response    String?
  qrCode      String?
  rsvpStatus  RsvpStatus            @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  event  Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests InvitationGuest[]

  @@unique([code])
  @@index([eventId])
  @@map("guest_invitation")
}

model InvitationGuest {
  id           String   @id @default(uuid())
  invitationId String
  guestId      String
  createdAt    DateTime @default(now())

  invitation GuestInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([invitationId, guestId])
  @@index([invitationId])
  @@index([guestId])
  @@map("invitation_guest")
}

model Table {
  id        String    @id @default(uuid())
  eventId   String
  name      String
  number    Int?
  capacity  Int
  location  String?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableGuests TableGuest[]

  @@index([eventId])
  @@map("table")
}

model TableGuest {
  id         String   @id @default(uuid())
  tableId    String
  guestId    String
  assignedAt DateTime @default(now())

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([tableId, guestId])
  @@index([tableId])
  @@index([guestId])
  @@map("table_guest")
}

model Task {
  id          String       @id @default(uuid())
  eventId     String
  title       String
  description String?
  category    TaskCategory
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  assignedTo  String?
  dueDate     DateTime?
  completedAt DateTime?
  completedBy String?
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee  User? @relation("TaskAssignee", fields: [assignedTo], references: [id])
  completer User? @relation("TaskCompleter", fields: [completedBy], references: [id])
  creator   User  @relation("TaskCreator", fields: [createdBy], references: [id])

  @@index([eventId])
  @@index([assignedTo])
  @@index([createdBy])
  @@map("task")
}

model Schedule {
  id          String         @id @default(uuid())
  eventId     String
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  location    String?
  responsible String?
  status      ScheduleStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("schedule")
}

model InventoryItem {
  id              String            @id @default(uuid())
  eventId         String
  name            String
  category        InventoryCategory
  plannedQuantity Decimal
  currentQuantity Decimal           @default(0)
  status          InventoryStatus   @default(PENDING)
  unit            InventoryUnit
  unitPrice       Decimal?
  notes           String?
  customFields    Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]
  checklistItems ChecklistItem[]

  @@index([eventId])
  @@index([eventId, category])
  @@map("inventory_item")
}

model InventoryMovement {
  id              String       @id @default(uuid())
  inventoryItemId String
  type            MovementType
  quantity        Decimal
  unitPrice       Decimal?
  totalCost       Decimal?
  reason          String?
  createdBy       String
  createdAt       DateTime     @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  creator       User          @relation(fields: [createdBy], references: [id])

  @@index([inventoryItemId])
  @@index([createdBy])
  @@map("inventory_movement")
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  eventId   String?
  type      NotificationType
  title     String
  message   String
  priority  NotificationPriority @default(INFO)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@map("notification")
}

model AuditLog {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@map("audit_log")
}

/// Append-only trail of what a user did, powering the Profile > History tab.
///
/// Distinct from `AuditLog`: that model is the event-scoped audit trail owned by
/// the dedications module (it requires an `eventId` and stores old/new entity
/// snapshots). This one covers every action across the whole account — sign-in,
/// profile edits, password changes, event and guest mutations — so `eventId` is
/// optional: security events like LOGIN belong to no event at all.
///
/// Never store credentials here. `metadata` is free-form context only; the
/// logger redacts secret-shaped keys before they reach this table.
model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  eventId     String?
  action      String
  resource    String
  resourceId  String?
  /// Human-readable summary rendered directly in the History table.
  description String
  /// Free-form context, e.g. `{ changes: [{ field, before, after }] }`.
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // The History tab always filters by owner and sorts by recency, so the
  // composite index serves both the WHERE and the ORDER BY.
  @@index([userId, createdAt])
  @@index([userId, action])
  @@index([userId, resource])
  @@map("activity_log")
}

// Private personal writing (vows, dedications, messages) owned by one event
// member. Content is Tiptap JSON — never raw HTML — and is never exposed to
// anyone outside the explicit viewer list.
model Dedication {
  id           String           @id @default(uuid())
  eventId      String
  ownerId      String
  title        String
  type         DedicationType
  status       DedicationStatus @default(NOT_STARTED)
  content      Json
  // true  → only the owner can read it.
  // false → only the members listed in `viewers` can read it. It NEVER means
  //         public, and it is never widened to "all members of the event".
  isLocked     Boolean          @default(true)
  lastOpenedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  event   Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner   User               @relation("DedicationOwner", fields: [ownerId], references: [id])
  viewers DedicationViewer[]

  @@index([eventId])
  @@index([ownerId])
  @@map("dedication")
}

// Explicit read grant for a single event member. Because the row is
// cascade-deleted with the EventMember, a member who leaves the event loses
// access automatically, and (dedicationId, eventMemberId) cannot be duplicated.
model DedicationViewer {
  id            String    @id @default(uuid())
  dedicationId  String
  eventMemberId String
  lastOpenedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  dedication  Dedication  @relation(fields: [dedicationId], references: [id], onDelete: Cascade)
  eventMember EventMember @relation(fields: [eventMemberId], references: [id], onDelete: Cascade)

  @@unique([dedicationId, eventMemberId])
  @@index([dedicationId])
  @@index([eventMemberId])
  @@map("dedication_viewer")
}
